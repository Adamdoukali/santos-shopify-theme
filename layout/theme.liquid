<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
  <title>{{ page_title }} | {{ shop.name }}</title>
  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% endif %}
  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="icon" type="image/png" href="{{ 'favicon.png' | asset_url }}">

  {{ 'app_style_balmoral.css' | asset_url | stylesheet_tag }}
  {{ 'santos-custom.css' | asset_url | stylesheet_tag }}
  {{ 'choice-reverse.css' | asset_url | stylesheet_tag }}

  {{ content_for_header }}
</head>
<body class="template-{{ template.name }}">

  {% section 'header' %}
  {% render 'choice-ticker' %}

  <main role="main" id="MainContent">
    {{ content_for_layout }}
  </main>

  {% section 'footer' %}

  {% render 'cart-drawer' %}
  {% render 'search-drawer' %}
  {% render 'quick-view-modal' %}
  {% render 'choice-cod-modal' %}

  {{ 'santos-theme.js' | asset_url | script_tag }}
  {{ 'choice-reverse.js' | asset_url | script_tag }}
</body>
</html>
